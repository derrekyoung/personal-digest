{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(python pipeline.py*)",
      "Bash(python3 -m venv*)",
      "Bash(pip:*)",
      "Bash(pip install:*)",
      "Bash(source:*)",
      "Bash(test:*)",
      "Bash(if:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cd:*)",
      "Read(*)",
      "Write(*)",
      "Update(*:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(force-push:*)",
      "Bash(git push --force:*)"
    ]
  },
  "defaultMode": "acceptEdits"
}