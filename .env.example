ANTHROPIC_API_KEY=your-anthropic-api-key-here
DIGEST_EMAIL_PASSWORD=your-app-password-here

# Optional — only needed if YouTube blocks transcript fetches.
# Local: read cookies straight from your logged-in browser (no file needed):
# YOUTUBE_COOKIES_FROM_BROWSER=safari   # or chrome, firefox, edge, brave
#
# Remote / portable: path to a Netscape-format cookies.txt
# (export via the "Get cookies.txt LOCALLY" browser extension while signed
# into youtube.com). Works locally and remotely.
# YOUTUBE_COOKIES_PATH=cookies.txt
